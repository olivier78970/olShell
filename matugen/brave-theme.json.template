{
  "manifest_version": 3,
  "name": "olShell",
  "version": "1.0",
  "description": "Brave's colors from olShell's palette, written by matugen from matugen/brave-theme.json.template (do not edit this file).",
  "theme": {
    "colors": {
      "frame": <* if {{olshell.exact}} *>[{{olshell.backgroundRgb}}]<* else *>[{{colors.background.default.red}}, {{colors.background.default.green}}, {{colors.background.default.blue}}]<* endif *>,
      "frame_inactive": <* if {{olshell.exact}} *>[{{olshell.backgroundRgb}}]<* else *>[{{colors.background.default.red}}, {{colors.background.default.green}}, {{colors.background.default.blue}}]<* endif *>,
      "background_tab": <* if {{olshell.exact}} *>[{{olshell.backgroundRgb}}]<* else *>[{{colors.background.default.red}}, {{colors.background.default.green}}, {{colors.background.default.blue}}]<* endif *>,
      "background_tab_inactive": <* if {{olshell.exact}} *>[{{olshell.backgroundRgb}}]<* else *>[{{colors.background.default.red}}, {{colors.background.default.green}}, {{colors.background.default.blue}}]<* endif *>,
      "toolbar": <* if {{olshell.exact}} *>[{{olshell.pillRgb}}]<* else *>[{{colors.surface_container.default.red}}, {{colors.surface_container.default.green}}, {{colors.surface_container.default.blue}}]<* endif *>,
      "omnibox_background": <* if {{olshell.exact}} *>[{{olshell.pillHighRgb}}]<* else *>[{{colors.surface_container_high.default.red}}, {{colors.surface_container_high.default.green}}, {{colors.surface_container_high.default.blue}}]<* endif *>,
      "ntp_background": <* if {{olshell.exact}} *>[{{olshell.backgroundRgb}}]<* else *>[{{colors.background.default.red}}, {{colors.background.default.green}}, {{colors.background.default.blue}}]<* endif *>,
      "tab_text": <* if {{olshell.exact}} *>[{{olshell.textRgb}}]<* else *>[{{colors.on_surface.default.red}}, {{colors.on_surface.default.green}}, {{colors.on_surface.default.blue}}]<* endif *>,
      "tab_background_text": <* if {{olshell.exact}} *>[{{olshell.textVariantRgb}}]<* else *>[{{colors.on_surface_variant.default.red}}, {{colors.on_surface_variant.default.green}}, {{colors.on_surface_variant.default.blue}}]<* endif *>,
      "tab_background_text_inactive": <* if {{olshell.exact}} *>[{{olshell.textVariantRgb}}]<* else *>[{{colors.on_surface_variant.default.red}}, {{colors.on_surface_variant.default.green}}, {{colors.on_surface_variant.default.blue}}]<* endif *>,
      "toolbar_text": <* if {{olshell.exact}} *>[{{olshell.textRgb}}]<* else *>[{{colors.on_surface.default.red}}, {{colors.on_surface.default.green}}, {{colors.on_surface.default.blue}}]<* endif *>,
      "toolbar_button_icon": <* if {{olshell.exact}} *>[{{olshell.textRgb}}]<* else *>[{{colors.on_surface.default.red}}, {{colors.on_surface.default.green}}, {{colors.on_surface.default.blue}}]<* endif *>,
      "bookmark_text": <* if {{olshell.exact}} *>[{{olshell.textRgb}}]<* else *>[{{colors.on_surface.default.red}}, {{colors.on_surface.default.green}}, {{colors.on_surface.default.blue}}]<* endif *>,
      "omnibox_text": <* if {{olshell.exact}} *>[{{olshell.textRgb}}]<* else *>[{{colors.on_surface.default.red}}, {{colors.on_surface.default.green}}, {{colors.on_surface.default.blue}}]<* endif *>,
      "ntp_text": <* if {{olshell.exact}} *>[{{olshell.textRgb}}]<* else *>[{{colors.on_background.default.red}}, {{colors.on_background.default.green}}, {{colors.on_background.default.blue}}]<* endif *>,
      "ntp_link": <* if {{olshell.exact}} *>[{{olshell.accentRgb}}]<* else *>[{{colors.primary.default.red}}, {{colors.primary.default.green}}, {{colors.primary.default.blue}}]<* endif *>
    }
  }
}
