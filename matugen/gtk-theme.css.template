/* GTK colors, from the shell's palette.
 *
 * Written by matugen from the current wallpaper - do not edit: change
 * matugen/gtk-theme.css.template in olShell instead.
 *
 * Used as ~/.config/gtk-4.0/gtk.css, and as the colors of the olShell GTK3
 * theme (see matugen/gtk3-theme-index.css.template). It only defines named
 * colors; the toolkit builds the widgets from them:
 *   - libadwaita apps (GTK4) read the first group, whatever GTK theme is set;
 *   - GTK3 apps read the second group, through the olShell theme (adw-gtk3,
 *     which is built on those names; a theme with hardcoded colors ignores them).
 * Semantic colors (success, warning) keep the toolkit's own.
 */

/* libadwaita */
@define-color accent_color <* if {{olshell.exact}} *>{{olshell.accent}}<* else *>{{colors.primary.default.hex}}<* endif *>;
@define-color accent_bg_color <* if {{olshell.exact}} *>{{olshell.accent}}<* else *>{{colors.primary.default.hex}}<* endif *>;
@define-color accent_fg_color <* if {{olshell.exact}} *>{{olshell.onAccent}}<* else *>{{colors.on_primary.default.hex}}<* endif *>;

@define-color destructive_color {{colors.error.default.hex}};
@define-color destructive_bg_color {{colors.error.default.hex}};
@define-color destructive_fg_color {{colors.on_error.default.hex}};

@define-color error_color {{colors.error.default.hex}};
